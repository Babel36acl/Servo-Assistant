{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "伺服参数调试器",
  "version": "0.4.2",
  "identifier": "com.servoassistant.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "伺服参数调试器",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/glib/LICENSE": "licenses/glib/LICENSE",
      "vendor/glib/COPYRIGHT": "licenses/glib/COPYRIGHT",
      "vendor/glib/PATCH.md": "licenses/glib/PATCH.md",
      "native/README.md": "licenses/ethercat-native.md",
      "native/soem/LICENSE": "licenses/SOEM-LICENSE.txt",
      "native/soem/oshw/win32/wpcap/Include/": "licenses/winpcap-sdk/"
    }
  }
}
